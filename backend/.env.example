# Postgres connection for backtesting (candles_1min, instruments, etc.)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading

# Angel One SmartAPI credentials -- needed later for forward/live testing, not yet used
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# News service (GDELT DOC is free and does not require a key)
NEWS_CACHE_TTL_SECONDS=60
# Optional comma-separated RSS feeds; defaults to Google News India market search
NEWS_RSS_URLS=https://news.google.com/rss/search?q=NIFTY+OR+RBI+OR+NSE&hl=en-IN&gl=IN&ceid=IN:en
# Optional calendar endpoint returning {"events": [...]} or an event array
MARKET_EVENTS_URL=
