# Matrix Calendar model assumptions. Override these for your research setup.
MATRIX_CALENDAR_MARGIN_PER_UNIT=100000
MATRIX_CALENDAR_UNITS=1
MATRIX_CALENDAR_TARGET_PCT=1.5
MATRIX_CALENDAR_STOP_PCT=2.0
MATRIX_CALENDAR_MIN_IV=0.20
MATRIX_CALENDAR_RISK_FREE_RATE=0.06
MATRIX_CALENDAR_DIVIDEND_YIELD=0.012
