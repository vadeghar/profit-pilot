# Production WebSocket endpoint. Leave unset to use the local UI tick simulator.
VITE_WS_URL=ws://localhost:8080/ws

# News service configuration. Keep NEWS_API_KEY server-side; never expose it as VITE_*
VITE_NEWS_API_URL=/api/news
NEWS_API_KEY=
NEWS_CACHE_TTL_MS=60000
# Optional calendar endpoint returning either an array of MarketEvent objects or { events: [...] }
MARKET_EVENTS_URL=
