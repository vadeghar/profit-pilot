# Postgres connection for backtesting (candles_1min, instruments, etc.)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading

# Angel One SmartAPI credentials -- needed later for forward/live testing, not yet used
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
