# Postgres connection for backtesting (candles_1min, instruments, etc.)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading

# Angel One SmartAPI credentials. When all are set, Analytics uses live SmartAPI
# WebSocket data; when blank or unavailable, it falls back to delayed Yahoo data.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# News service (GDELT DOC is free and does not require a key)
NEWS_CACHE_TTL_SECONDS=60
# Optional comma-separated RSS feeds; defaults to Google News India market search
NEWS_RSS_URLS=https://news.google.com/rss/search?q=NIFTY+OR+RBI+OR+NSE&hl=en-IN&gl=IN&ceid=IN:en
# Optional comma-separated NSE holiday dates (YYYY-MM-DD) from the official annual calendar
NSE_HOLIDAYS=
# Optional calendar endpoint returning {"events": [...]} or an event array
MARKET_EVENTS_URL=
# Optional public RSS feeds. NSE publishes Financial Results and Board Meetings feeds;
# use the feed URLs exposed on https://www.nseindia.com/static/rss-feed.
NSE_RSS_URLS=
# BSE has public corporate filings but no stable documented RSS endpoint; set this only
# when using a permitted public RSS/JSON mirror or your own normalized adapter.
BSE_RSS_URLS=
BSE_EVENTS_URL=
# Comma-separated exchange symbols used to limit earnings events to major companies.
TOP_COMPANIES=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY,ITC,SBIN,BHARTIARTL,LT,AXISBANK,KOTAKBANK,HINDUNILVR,BAJFINANCE,MARUTI,ASIANPAINT
# Optional official iCalendar feed, e.g. BLS release calendar
GLOBAL_MACRO_ICS_URL=https://www.bls.gov/schedule/news_release/bls.ics

# Analytics uses a free external delayed market-data adapter. It does not use
# the strategy/backtesting Postgres database.
ANALYTICS_SYMBOLS=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY,ITC,SBIN,BHARTIARTL,LT,AXISBANK,KOTAKBANK,HINDUNILVR,BAJFINANCE,MARUTI,ASIANPAINT
ANALYTICS_INITIAL_WAIT_SECONDS=5
ANALYTICS_STREAM_INTERVAL_SECONDS=15
ANALYTICS_CACHE_TTL_SECONDS=60

# Production WebSocket endpoint. Leave unset to use the local UI tick simulator.
VITE_WS_URL=ws://localhost:8080/ws
# Relative API base. Vite proxies /api to FastAPI during local development.
VITE_API_URL=/api

# Titan Condor backtest defaults
TITAN_CONDOR_UNITS=10
TITAN_CONDOR_MARGIN_PER_LOT=30000
TITAN_CONDOR_TARGET_PCT=1.0
TITAN_CONDOR_EXTRA_CALL_LOTS=1
